APP_PORT=8080
HOST_PORT=8080 # Только для DEV на проде нет контейнера

DB_HOST=container_db_name
DB_PORT=5432
DB_HOST_PORT=5433
DB_USER=db_user
DB_PASSWORD=db_password
DB_NAME=db_name
TEST_DB_NAME=filevault_test
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable&application_name=filevault
TEST_DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${TEST_DB_NAME}?sslmode=disable&application_name=filevault

MAX_UPLOAD_BYTES=1073741824 
STORAGE_DIR=/app/storage